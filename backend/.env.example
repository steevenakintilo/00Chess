# Copie ce fichier en .env pour le développement local (Railway : mets ces variables dans l'onglet Variables).
SECRET_KEY=change-me-en-une-longue-chaine-aleatoire
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Postgres local, ou l'URL fournie par Railway (variable DATABASE_URL du plugin Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chess00
# Adresses du front autorisées à appeler l'API (séparées par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://www.play00chess.com
